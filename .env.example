# Demo mode is the only runnable mode until a real Supabase project is configured.
NEXT_PUBLIC_APP_MODE=demo
# Platform for this deployment: SA (Marifa Saudi) or IN (Marifa India). Each points at its own Supabase project.
# Leave empty locally to keep the region toggle for side-by-side checks.
NEXT_PUBLIC_MARIFA_REGION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DOCUMENT_SIGNING_SECRET=
AI_PROVIDER_API_KEY=

# Recent Developments summaries (optional): AI summaries of free PubMed abstracts
ANTHROPIC_API_KEY=
NCBI_API_KEY=
